# Telegram Bot Configuration
TELEGRAM_BOT_TOKEN=your_bot_token_here
TELEGRAM_CHAT_ID=your_chat_id_here

# Digest schedule (24h format, UTC)
DIGEST_HOUR=9
DIGEST_MINUTE=0

# Optional: run once immediately on start (true/false)
RUN_ON_START=true

# Logging level (DEBUG, INFO, WARNING, ERROR)
LOG_LEVEL=INFO
